# Application Environment
APP_ENV=development
SECRET_KEY=nani_ai_sales_caller_secure_random_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL recommended; defaults to SQLite for immediate local testing if PostgreSQL is not running)
DATABASE_URL=sqlite:///./calling_agent.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nani_sales_caller

# Indian Telephony Provider (options: 'simulated', 'exotel', 'twilio')
TELEPHONY_PROVIDER=simulated
TELEPHONY_API_KEY=your_exotel_or_twilio_api_key
TELEPHONY_API_SECRET=your_exotel_or_twilio_api_secret
TELEPHONY_ACCOUNT_SID=your_exotel_sid_or_twilio_sid
TELEPHONY_VIRTUAL_NUMBER=+918000000000
TELEPHONY_WEBHOOK_SECRET=your_webhook_signature_secret
TELEPHONY_PUBLIC_URL=https://your-domain.ngrok-free.app

# Speech Providers (options: 'sarvam', 'elevenlabs', 'openai', 'browser')
# Sarvam AI - Outstanding native Telugu and Indian English STT & TTS
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_VOICE_ID=bulbul:v1
SARVAM_MODEL=saaras:v1

# ElevenLabs - High-fidelity multilingual Indian male voice
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL=eleven_multilingual_v2

# Voice AI & LLM Intelligence
LLM_PROVIDER=openai
LLM_API_KEY=your_openai_or_groq_api_key
LLM_MODEL=gpt-4o-mini
DEFAULT_VOICE_PROVIDER=sarvam

# Regulatory and Compliance (TRAI Guidelines)
TRAI_CALLING_WINDOW_START_HOUR=9
TRAI_CALLING_WINDOW_END_HOUR=20
MAX_CONCURRENT_CALLS_DEFAULT=2
CALL_RETRY_LIMIT=3
CALL_RETRY_INTERVAL_MINUTES=60
